# ---------- Production (Vercel > Project > Settings > Environment Variables) ----------
# Read-only token, valid 1 year. Create it at https://account.upstox.com/developer/apps
# (Developer Apps page > Analytics tab). Needs no login flow and no static IP for market data.
UPSTOX_ANALYTICS_TOKEN=
# The password the client types on the sign-in screen. Checked on the server.
SITE_PASSWORD=
# Any long random text (16+ characters). Signs session tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Local development only (npm run dev, WebSocket feed with OAuth login) ----------
# Create an app at https://account.upstox.com/developer/apps
# Redirect URL on that app must match this exactly:
# http://127.0.0.1:5173/api/upstox/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:5173/api/upstox/callback
